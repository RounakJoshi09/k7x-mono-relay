{
  "compilerOptions": {
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "module": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": ["./**/*.mts"],
  "exclude": ["dist", "node_modules", "logs"]
}
