{
  "name": "tally-database-loader-app",
  "version": "1.0.0",
  "description": "Tally Database Loader - Desktop Application",
  "main": "dist/main.js",
  "homepage": "./",
  "author": "Tally Database Loader Team",
  "license": "ISC",
  "scripts": {
    "build": "npm run build:core && tsc && npm run copy-files",
    "build:core": "cd core && tsc",
    "copy-files": "copyfiles -u 1 src/renderer/**/* dist/ && copyfiles -u 1 src/assets/**/* dist/ && copyfiles -u 2 core/dist/**/* dist/core/dist/ && copyfiles -u 1 node_modules/**/* dist/node_modules/ && copyfiles tally-export-config*.yaml dist/",
    "build:watch": "npm run build:core && tsc --watch",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --dev",
    "pack": "npm run build && electron-builder --dir --publish=never",
    "dist": "npm run build && electron-builder --publish=never",
    "dist:win": "npm run build && electron-builder --win --publish=never",
    "dist:win-msi": "npm run build && electron-builder --win msi --publish=never",
    "dist:win-nsis": "npm run build && electron-builder --win nsis --publish=never",
    "dist:all": "npm run build && electron-builder --win --mac --linux --publish=never",
    "clean": "rimraf dist build",
    "postinstall": "electron-builder install-app-deps",
    "test:core": "node test-core-modules.js",
    "test:simple": "node test-simple-core.js",
    "test:deps": "node test-dependencies.js",
    "test:packaged": "node test-packaged-deps.js",
    "verify": "node verify-build.js",
    "check-installed": "node check-installed-app.js",
    "prepack": "npm run build:core",
    "predist": "npm run build:core",
    "predist:win": "npm run build:core",
    "predist:win-msi": "npm run build:core",
    "predist:win-nsis": "npm run build:core",
    "predist:all": "npm run build:core"
  },
  "build": {
    "appId": "com.tallydatabaseloader.app",
    "productName": "Tally Database Loader",
    "directories": {
      "output": "build",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "src/renderer/**/*",
      "src/assets/**/*",
      "core/**/*",
      "node_modules/**/*",
      "!node_modules/**/test/**/*",
      "!node_modules/**/*.md",
      "!node_modules/**/LICENSE*",
      "!node_modules/**/README*",
      "!node_modules/**/.bin/**/*"
    ],
    "extraResources": [
      {
        "from": "./config-default.json",
        "to": "config-default.json"
      },
      {
        "from": "./tally-export-config.yaml",
        "to": "tally-export-config.yaml"
      },
      {
        "from": "./tally-export-config-incremental.yaml",
        "to": "tally-export-config-incremental.yaml"
      },
      {
        "from": "./database-structure.sql",
        "to": "database-structure.sql"
      },
      {
        "from": "./database-structure-incremental.sql",
        "to": "database-structure-incremental.sql"
      },
      {
        "from": "./core/dist",
        "to": "core"
      },
      {
        "from": "./node_modules",
        "to": "node_modules"
      },
      {
        "from": "./platform",
        "to": "platform"
      },
      {
        "from": "./reports",
        "to": "reports"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icon.png"
    },
    "nsis": {
      "artifactName": "TallyDatabaseLoader-${version}-setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "src/assets/icon.ico",
      "uninstallerIcon": "src/assets/icon.ico",
      "installerHeaderIcon": "src/assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tally Database Loader",
      "perMachine": true,
      "warningsAsErrors": false,
      "include": "installer-script.nsh"
    },
    "msi": {
      "artifactName": "TallyDatabaseLoader-${version}-setup.msi",
      "oneClick": false,
      "perMachine": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tally Database Loader",
      "warningsAsErrors": false
    },
    "portable": {
      "artifactName": "TallyDatabaseLoader-${version}-portable.exe"
    },
    "forceCodeSigning": false,
    "electronVersion": "27.1.0",
    "afterSign": null,
    "afterAllArtifactBuild": null,
    "beforeBuild": null,
    "beforePack": null,
    "afterPack": null,
    "buildDependenciesFromSource": false,
    "buildVersion": "1.0.0",
    "compression": "maximum",
    "copyright": "Copyright © 2024",
    "icon": "src/assets/icon.png",
    "extraMetadata": {
      "main": "dist/main.js"
    },
    "generateUpdatesFilesForAllChannels": false,
    "includeSubNodeModules": true,
    "nodeGypRebuild": false,
    "npmRebuild": false,
    "removePackageScripts": false,
    "removePackageKeywords": false
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.15.4",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/ssh2": "^1.15.5",
    "@types/ws": "^8.18.1",
    "copyfiles": "^2.4.1",
    "electron": "^27.1.0",
    "electron-builder": "^24.6.4",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@azure/storage-file-datalake": "^12.24.0",
    "@google-cloud/bigquery": "^7.9.0",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.4",
    "js-yaml": "^4.1.0",
    "mysql2": "^3.11.3",
    "pg": "^8.13.0",
    "pg-copy-streams": "^6.0.6",
    "ssh2": "^1.16.0",
    "tedious": "^18.6.1",
    "ws": "^8.18.0"
  }
}
