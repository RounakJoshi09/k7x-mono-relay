{
  "name": "tally-database-loader-app",
  "version": "1.0.0",
  "description": "Tally Database Loader - Desktop Application",
  "main": "dist/main.js",
  "homepage": "./",
  "author": "Tally Database Loader Team",
  "license": "ISC",
  "scripts": {
    "build": "npm run build:core && tsc && npm run copy-files",
    "build:core": "cd core && tsc",
    "copy-files": "copyfiles -u 1 src/renderer/**/* dist/ && copyfiles -u 1 src/assets/**/* dist/",
    "build:watch": "npm run build:core && tsc --watch",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --dev",
    "pack": "npm run build && electron-builder --dir --publish=never",
    "dist": "npm run build && electron-builder --publish=never",
    "dist:win": "npm run build && electron-builder --win --publish=never",
    "dist:all": "npm run build && electron-builder --win --mac --linux --publish=never",
    "clean": "rimraf dist build"
  },
  "build": {
    "appId": "com.tallydatabaseloader.app",
    "productName": "Tally Database Loader",
    "directories": {
      "output": "build",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "src/renderer/**/*",
      "src/assets/**/*",
      "core/**/*",
      "node_modules/**/*",
      "!node_modules/**/test/**/*",
      "!node_modules/**/*.md",
      "!node_modules/**/LICENSE*",
      "!node_modules/**/README*"
    ],
    "extraResources": [
      {
        "from": "../config.json",
        "to": "config.json"
      },
      {
        "from": "../tally-export-config.yaml",
        "to": "tally-export-config.yaml"
      },
      {
        "from": "../tally-export-config-incremental.yaml",
        "to": "tally-export-config-incremental.yaml"
      },
      {
        "from": "../database-structure.sql",
        "to": "database-structure.sql"
      },
      {
        "from": "../database-structure-incremental.sql",
        "to": "database-structure-incremental.sql"
      },
      {
        "from": "../platform",
        "to": "platform"
      },
      {
        "from": "../reports",
        "to": "reports"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icon.ico",
      "publish": null,
      "sign": false,
      "verifyUpdateCodeSignature": false,
      "forceCodeSigning": false,
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "TallyDatabaseLoader-${version}-portable.exe"
    },
    "forceCodeSigning": false,
    "electronVersion": "27.1.0",
    "afterSign": null,
    "afterAllArtifactBuild": null,
    "beforeBuild": null,
    "beforePack": null,
    "afterPack": null,
    "artifactBuildTimeout": 0,
    "buildDependenciesFromSource": false,
    "buildVersion": "1.0.0",
    "compression": "normal",
    "copyright": "Copyright © 2024",
    "extraMetadata": {
      "main": "dist/main.js"
    },
    "generateUpdatesFilesForAllChannels": false,
    "includeSubNodeModules": false,
    "nodeGypRebuild": false,
    "npmRebuild": false,
    "removePackageScripts": false,
    "removePackageKeywords": false
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "copyfiles": "^2.4.1",
    "electron": "^27.1.0",
    "electron-builder": "^24.6.4",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@azure/storage-file-datalake": "^12.24.0",
    "@google-cloud/bigquery": "^7.9.0",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.4",
    "js-yaml": "^4.1.0",
    "mysql2": "^3.11.3",
    "pg": "^8.13.0",
    "pg-copy-streams": "^6.0.6",
    "ssh2": "^1.16.0",
    "tedious": "^18.6.1",
    "ws": "^8.18.0"
  }
}
